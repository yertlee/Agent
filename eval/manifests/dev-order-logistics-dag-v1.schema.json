{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "manifest_id", "dataset_version", "model_repetitions", "fault_repetitions", "cases"],
  "properties": {
    "schema_version": {"const": "r2.eval.manifest.v1"},
    "manifest_id": {"const": "dev-order-logistics-dag-v1"},
    "dataset_version": {"const": "dev-order-logistics-dag-v1"},
    "model_repetitions": {"const": 3},
    "fault_repetitions": {"const": 1},
    "cases": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true, "items": {
      "type": "object", "required": ["case_id", "category", "execution_class", "input_ref", "expected_status", "expected_code", "expected_intent", "expected_tool_path"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "category": {"enum": ["valid", "order_only", "logistics_only", "unauthorized", "missing_order", "missing_entity", "safe_stop", "stale", "conflict", "bounded_replan"]},
        "execution_class": {"enum": ["model", "fault"]},
        "input_ref": {"type": "string", "minLength": 1},
        "expected_status": {"type": "string"},
        "expected_code": {"type": ["string", "null"]},
        "expected_intent": {"type": ["string", "null"]},
        "expected_tool_path": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
