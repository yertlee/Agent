# LLM
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Local ecommerce sqlite database used by order / aftersales tools
ECOMMERCE_DB_PATH=./ecommerce.db

# Local deterministic logistics simulator
LOGISTICS_MODE=SIMULATED
LOGISTICS_TIMEOUT_SECONDS=10

# Cache settings for local scenario replay
LOGISTICS_CACHE_TTL_MINUTES=30
LOGISTICS_MIN_QUERY_INTERVAL_MINUTES=30
LOGISTICS_CACHE_DIR=./runtime/logistics_cache

# Optional local embedding model override for policy retrieval
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
