# LLM
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-v3

# Local ecommerce sqlite database used by order / aftersales tools
ECOMMERCE_DB_PATH=d:\path\to\ecommerce.db

# Logistics provider selection
# auto: use kuaidi100 when credentials exist, otherwise fallback to mock
# kuaidi100: always use real kuaidi100 provider
# mock: always use mock provider
LOGISTICS_PROVIDER_MODE=auto

# Kuaidi100
KUAIDI100_API_URL=https://poll.kuaidi100.com/poll/query.do
KUAIDI100_CUSTOMER=your-kuaidi100-customer
KUAIDI100_KEY=your-kuaidi100-key
LOGISTICS_QUERY_RESULTV2=4
LOGISTICS_TIMEOUT_SECONDS=10

# Cache-first logistics lookup
# Kuaidi100 recommends leaving at least 30 minutes between repeated queries
# for the same tracking number, otherwise the waybill may be locked temporarily.
LOGISTICS_CACHE_TTL_MINUTES=30
LOGISTICS_MIN_QUERY_INTERVAL_MINUTES=30
LOGISTICS_CACHE_DIR=d:\Myproject\LLMproject1\runtime\logistics_cache

# Optional local embedding model override for policy retrieval
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
